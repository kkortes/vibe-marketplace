{
  "name": "vibe-marketplace",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun compile:watch & bunx live-server compiled --port=3000 --host=localhost",
    "build": "bun compile",
    "compile": "rm -rf compiled && bunx vibe compile && mv compiled/node_modules compiled/modules",
    "compile:watch": "bun compile && bunx vibe compile --watch --no-clean",
    "test": "bun test"
  },
  "dependencies": {
    "@ape-egg/async-await-websockets": "^3.4.0",
    "@ape-egg/codie": "^0.1.5",
    "@ape-egg/vibe": "^4.3.0"
  },
  "devDependencies": {
    "@ape-egg/vibe-compiler": "^4.3.0"
  },
  "vibe-compiler": {
    "source": "./app",
    "output": "./compiled",
    "components": "components",
    "elementsAsIs": true,
    "nodeModulesAsIs": false,
    "minify": false
  }
}
