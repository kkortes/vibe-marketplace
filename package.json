{
  "name": "viberary",
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "\"$(git rev-parse --path-format=absolute --git-common-dir)/../../dev.sh\" 'bun compile:watch & bunx wrangler dev --port=$PORT --ip=localhost'",
    "build": "bun compile",
    "compile": "mkdir -p compiled && find compiled -mindepth 1 -delete && bunx vibe compile --no-clean && mv compiled/node_modules/@ape-egg compiled/modules && rm -r compiled/node_modules",
    "compile:watch": "bun compile && bunx vibe compile --watch --no-clean",
    "test": "bun test",
    "fade": "bun scripts/fade.js"
  },
  "dependencies": {
    "@ape-egg/async-await-websockets": "^3.9.0",
    "@ape-egg/codie": "^0.2.1",
    "@ape-egg/vibe": "^4.3.23"
  },
  "devDependencies": {
    "@ape-egg/vibe-compiler": "^4.3.23",
    "wrangler": "^4.155.0"
  },
  "vibe-compiler": {
    "source": "./app",
    "output": "./compiled",
    "components": "components",
    "elementsAsIs": true,
    "nodeModulesAsIs": false,
    "minify": false
  }
}
