{
  "name": "viberary",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "\"$(git rev-parse --path-format=absolute --git-common-dir)/../../dev.sh\" 'bun compile:watch & bunx live-server compiled --port=$PORT --host=localhost'",
    "build": "bun compile",
    "compile": "rm -rf compiled && bunx vibe compile && mv compiled/node_modules compiled/modules",
    "compile:watch": "bun compile && bunx vibe compile --watch --no-clean",
    "test": "bun test"
  },
  "dependencies": {
    "@ape-egg/async-await-websockets": "^3.7.1",
    "@ape-egg/codie": "^0.2.1",
    "@ape-egg/vibe": "^4.3.23"
  },
  "devDependencies": {
    "@ape-egg/vibe-compiler": "^4.3.23"
  },
  "vibe-compiler": {
    "source": "./app",
    "output": "./compiled",
    "components": "components",
    "elementsAsIs": true,
    "nodeModulesAsIs": false,
    "minify": false
  }
}
