      "migrations_dir": "./server/migrations"
    }
  ],
  "vars": {
    "GOOGLE_CLIENT_ID": "818843980176-15qn16b9k8b0gfv2q518bf4dbb159vg7.apps.googleusercontent.com"
  }
}
